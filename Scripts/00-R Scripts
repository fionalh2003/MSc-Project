# ridgeline plot for intergenic loci
#===============================================================================
# Ridgeline plot of intergenic lncRNA distances to the nearest protein-coding gene
#===============================================================================

#------------------------------------------------------------------------------
# Install/load packages
#------------------------------------------------------------------------------

install_if_missing <- function(package) {
  if (!require(package, character.only = TRUE, quietly = TRUE)) {
    install.packages(package, repos = "https://cloud.r-project.org")
    library(package, character.only = TRUE)
  }
}

install_if_missing("ggplot2")
install_if_missing("ggridges")
install_if_missing("readr")
install_if_missing("dplyr")

library(ggplot2)
library(ggridges)
library(readr)
library(dplyr)

#------------------------------------------------------------------------------
# File locations (EDIT THESE IF NEEDED)
#------------------------------------------------------------------------------

distance_file <- "C:/Users/Fiona/11-IntergenicDistances.tsv"
output_dir <- "C:/Users/Fiona/Downloads"

#------------------------------------------------------------------------------
# Load data
#------------------------------------------------------------------------------

distances <- read_tsv(
  distance_file,
  col_names = c("distance", "strain"),
  show_col_types = FALSE
)

#------------------------------------------------------------------------------
# Remove transcripts with zero distance
#------------------------------------------------------------------------------

distances <- distances %>%
  filter(distance > 0)

#------------------------------------------------------------------------------
# Log-transform distances
#------------------------------------------------------------------------------

distances <- distances %>%
  mutate(log_distance = log10(distance + 1))

#------------------------------------------------------------------------------
# Order strains
#------------------------------------------------------------------------------

distances$strain <- factor(
  distances$strain,
  levels = c(
    "4401",
    "A1",
    "A4Hap1",
    "A4Hap2",
    "A5Hap1",
    "A5Hap2",
    "B3",
    "C2",
    "DAOM",
    "G1Hap1",
    "G1Hap2",
    "SL1Hap1",
    "SL1Hap2"
  )
)

#------------------------------------------------------------------------------
# Create ridgeline plot
#------------------------------------------------------------------------------

p <- ggplot(
  distances,
  aes(
    x = log_distance,
    y = strain,
    fill = after_stat(x)
  )
) +
  geom_density_ridges_gradient(
    scale = 2,
    rel_min_height = 0.01,
    gradient_lwd = 0.3,
    linewidth = 0.3,
    alpha = 0.9
  ) +
  scale_fill_gradientn(
    colours = c(
      "#FCE4EC",  # very light pink
      "#F48FB1",  # pink
      "#CE93D8",  # lavender
      "#9C27B0",  # purple
      "#4B0082"   # deep indigo
    ),
    name = expression(log[10] * "(Distance)")
  ) +
  labs(
    title = "Distribution of intergenic lncRNA distances to the nearest protein-coding gene",
    x = expression(log[10] * "(Distance to nearest gene (bp) + 1)"),
    y = NULL
  ) +
  theme_ridges(font_size = 13) +
  theme(
    plot.title = element_text(face = "bold", hjust = 0.5, size = 15),
    
    axis.title.x = element_text(size = 12),
    axis.text.x = element_text(size = 10, colour = "black"),
    axis.text.y = element_text(size = 11, colour = "black"),
    
    # Add axis lines and ticks
    axis.line.x = element_line(colour = "black", linewidth = 0.6),
    axis.line.y = element_line(colour = "black", linewidth = 0.6),
    axis.ticks.x = element_line(colour = "black", linewidth = 0.5),
    axis.ticks.y = element_line(colour = "black", linewidth = 0.5),
    axis.ticks.length = unit(0.2, "cm"),
    
    # White background
    panel.background = element_rect(fill = "white", colour = NA),
    plot.background = element_rect(fill = "white", colour = NA),
    
    # Remove grid
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    
    legend.position = "right",
    legend.title = element_text(size = 11),
    legend.text = element_text(size = 10)
  )
#------------------------------------------------------------------------------
# Display plot
#------------------------------------------------------------------------------

print(p)

#------------------------------------------------------------------------------
# Save figures
#------------------------------------------------------------------------------

ggsave(
  filename = file.path(output_dir, "Intergenic_Ridgeline_PinkPurple.png"),
  plot = p,
  width = 10,
  height = 6,
  dpi = 300,
  bg = "white"
)

ggsave(
  filename = file.path(output_dir, "Intergenic_Ridgeline_PinkPurple.pdf"),
  plot = p,
  width = 10,
  height = 6,
  bg = "white"
)

cat("\nFinished!\n")
cat("Figures saved to:\n")
cat(output_dir, "\n")
