# length filtering  
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1 
do 
seqkit seq -m 200 01-$i-illumina-filtered-simple.fasta > 02-$i-length-filtered.fasta
done 

# convert to orfs
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1 
do 
getorf -sequence 02-$i-length-filtered.fasta -outseq 03-$i-orfs.fasta -minsize 300
done

# filter orfs
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1 
do 
grep ">" 03-$i-orfs.fasta | sed 's/>//' | cut -d" " -f1 > 03-$i-long-orfs.txt
wait
seqkit grep -v -f 03-$i-long-orfs.txt 02-$i-length-filtered.fasta -o 04-$i-orf-filtered.fasta
done
