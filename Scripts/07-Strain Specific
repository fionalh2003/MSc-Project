# add strain name to header (00-Strain.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
    sed "s/^>/>${i}_/" 02-$i-lncRNA-Candidates.fasta > 03-$i-lncRNA-Candidates.fasta
done

# Cluster file
cat 02* > 01-Joint-lncRNA.fasta
cd-hit-est -i 03-Joint-lncRNA.fasta   -o 04-Clustered-lncRNA.fasta   -c 0.98   -aS 0.95   -aL 0.95   -G 0   -g 1   
