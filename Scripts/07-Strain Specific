# add strain name to header (00-Strain.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
    sed "s/^>/>${i}_/" 02-$i-lncRNA-Candidates.fasta > 03-$i-lncRNA-Candidates.fasta
done

# Longest Isoform (00-LongestIsoform.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
seqkit fx2tab -n -l 03-$i-lncRNA-Candidates.fasta \
| awk '
{
    split($1,a,".");
    locus=a[1]"."a[2];
    if($2>len[locus]){
        len[locus]=$2;
        id[locus]=$1;
    }
}
END{
    for(i in id)
        print id[i]
}' > 03-$i-lncRNA-LongestIsoform.txt

wait

seqkit grep -f 03-$i-lncRNA-LongestIsoform.txt 03-$i-lncRNA-Candidates.fasta > 04-$i-lncRNA-Loci.fasta
done

# Cluster file
cat 04* > 05-Joint-lncRNA.fasta
cd-hit-est -i 05-Joint-lncRNA.fasta   -o 06-Clustered-lncRNA.fasta   -c 0.98   -aS 0.95   -aL 0.95   -G 0   -g 1   

Mapping to genome (Mapping.sh)
for i in A4Hap1 A4Hap2 A5Hap1 A5Hap2 G1Hap1 G1Hap2 SL1Hap1 SL1Hap2 4401 A1 B3 C2 DAOM
do
minimap2 -x splice:hq -uf 01-$i-genome.fasta 06-Clustered-lncRNA.fasta > 07-$i-MiniMap.txt
done

#Filtering Mapping (FilteringMap.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
    awk 'BEGIN{OFS="\t"}
    {
        coverage = ($4-$3)/$2

        primary = 0
        dv = 1

        for(i=13;i<=NF;i++){
            if($i=="tp:A:P") primary=1
            if($i~/^dv:f:/){
                split($i,a,":")
                dv=a[3]
            }
        }

        if(primary &&
           $12>=60 &&
           coverage>=0.90 &&
           dv<=0.05)
            print
    }' 07-$i-MiniMap.txt > 08-$i-FilteredMiniMap.txt
done

# Simplify hetero minimap
for i in A4-hap1 A4-hap2 A5-hap1 A5-hap2 G1-hap1 G1-hap2 SL1-hap1 SL1-hap2
do  
    awk '{split($6, a, "_"); print $1, a[2], a[3]}' 08-$i-FilteredMiniMap.txt > 09-$i-lncRNAnStrainMiniMap.txt
done

# Simplify homo minimap
for i in 4401 A1 B3 C2 DAOM 
do
    awk '{print $1, substr($6, 1, index($6, "_") - 1)}' 08-$i-FilteredMiniMap.txt > 09-$i-lncRNAnStrainMiniMap.txt
done

# finding strain specific 
cat 09* > 10-MergedMapped.txt
awk '{print $1, $2}' 10-MergedMapped.txt | sort -u > 11-MergedStrain.txt
awk '{seen[$1][$2]=1; rows[$1]=rows[$1] $0 ORS} END{for(t in seen){n=0; for(s in seen[t]) n++; if(n==1) printf "%s", rows[t]}}' 11-MergedStrain.txt > 12-StrainSpecific.txt
awk '{count[$2]++} END{for(s in count) print s, count[s]}' 12-StrainSpecific.txt | sort

 # Finding shared transcripts
awk '{t[$1][$2]=1; strains[$2]=1} END{for(s in strains)n++; for(tr in t){c=0; for(s in t[tr])c++; if(c==n) print tr}}' 11-MergedStrain.txt > 12-StrainShared.txt
wc -l 12-StrainShared.txt

 # Finding haplotype specific
awk '{print $1, $2"-"$3}' OFS='\t' 11-MergedMapped.txt > 11-Haplotype.txt
awk '{print $1, $2}' 11-Haplotype.txt | sort -u > 11-MergedHaplotype.txt
awk '{seen[$1][$2]=1; rows[$1]=rows[$1] $0 ORS} END{for(t in seen){n=0; for(s in seen[t]) n++; if(n==1) printf "%s", rows[t]}}' 11-MergedHaplotype.txt > 12-HaplotypeSpecific.txt
awk '{count[$2]++} END{for(s in count) print s, count[s]}' 12-HaplotypeSpecific.txt | sort
