# filter gff (00-FilterGff.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
grep -F -w -f 03-$i-length-filtered.txt 05-$i-mapped.gff > 01-$i-lncRNA-Mapped.gff
wait
gffread 01-$i-lncRNA-Mapped.gff -T -o 01-$i-lncRNA-Mapped.gtf
done

# Running Gff compare (00-Gffcompare.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
gffcompare -r 02-${i}-gene-ann-mod.gtf -o 04-${i}-GFFCompare 01-$i-lncRNA-Mapped.gtf
done

# Filter for only lncRNA codes (00-Codes.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
  awk '
    match($0, /transcript_id "([^"]+)"/, id) {
      tid = id[1]
      lines[tid] = lines[tid] $0 "\n"
      if ($3 == "transcript" && $0 ~ /class_code "[uixo]"/) keep[tid] = 1
    }
    END {
      for (tid in keep)
        printf "%s", lines[tid]
    }
  ' "04-$i-GFFCompare.annotated.gtf" > "06-$i-lncRNA_candidates.gtf"
done

# Just transcript ID and code (00-GffIDs.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
awk '$0 ~ /class_code "[a-z]"/ {
  match($0, /transcript_id "([^"]+)"/, t);
  match($0, /class_code "([^"]+)"/, c);
  print t[1] "\t" c[1]
}' 06-$i-lncRNA_candidates.gtf > 07-$i-lncRNA_ClassCodes.txt
wait
sort -u 07-$i-lncRNA_ClassCodes.txt > 07-$i-lncRNA_UniqueClassCodes.txt
wait
awk '{print $1}' 07-$i-lncRNA_UniqueClassCodes.txt > 08-$i-GffCompare-lncRNA.txt
done

# Make fasta of predicted lncRNA genes (00-GffFasta.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
 seqkit grep -n -f 08-$i-GffCompare-lncRNA.txt \
    02-$i-length-filtered.fasta \
    > 09-$i-GffCompare-lncRNA.fasta
done

