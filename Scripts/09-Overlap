# merge bed file with class code (00-Codes.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
awk '$3=="transcript"' 04-$i-GFFCompare.annotated.gtf | awk '
{
  match($0, /gene_id "([^"]+)"/, g);
  match($0, /class_code "([^"]+)"/, c);
  print g[1]"\t"c[1]
}' > 03-$i-Class.tsv
wait
awk '{count[$1" "$2]++; genes[$1]++} END {
for (i in count) {
split(i,a," ");
gene=a[1]; code=a[2];
print gene"\t"code
}
}' 03-$i-Class.tsv > 03-$i-gene-class.collapsed.tsv
wait
awk 'NR==FNR{a[$1]=$2; next} {print $0"\t"a[$2]}' \
03-$i-gene-class.collapsed.tsv \
07-$i-lncRNA-loci.bed \
> 08-$i-lncRNA-loci-codes.bed
done

# seperate haplotypes (00-Haplotype.sh)
for i in A4 A5 G1 SL1
do
awk '$1 ~ /_Hap1$/' 08-$i-lncRNA-loci-codes.bed > 08-${i}Hap1-lncRNA-loci.bed
wait
awk '$1 ~ /_Hap2$/' 08-$i-lncRNA-loci-codes.bed > 08-${i}Hap2-lncRNA-loci.bed
done

# fix the chromosomes (00-Chromosomes.sh)
for i in A4Hap1 A4Hap2 A5Hap1 A5Hap2 G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
awk '
  BEGIN { OFS="\t" }
  {
    chrom = $1
    sub(/_.*/, "", chrom)
    sub(/^chr/, "chr_", chrom)
    $1 = chrom
    print
  }
' 08-$i-lncRNA-loci-codes.bed > 09-$i-lncRNA-loci-codes.bed
done

# seperate the class codes (00-SeperateCodes.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
awk '{print > "'09-$i'_"$6".bed"}' 08-$i-lncRNA-loci-codes.bed
done

# sort the bed files (00-SORT.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
sort -k1,1 -k2,2n 02-$i-u.bed > 02-$i-u-sorted.bed
done

# closest gene (00-IntergenicDistance.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
  bedtools closest \
    -a "02-${i}-u-sorted.bed" \
    -b "01-${i}-genes.sorted.bed" \
    -d > "03-${i}-IntergenicDistance.tsv"
done

# overlap for Sense (00-SenseOverlap.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
    bedtools intersect \
        -a 01-$i-o.bed \
        -b 01-$i-genes.sorted.bed \
        -wo \
        > 02-$i-SenseOverlap.txt
done

# overlap for antisense (00-AntisenseOverlap.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
    bedtools intersect \
        -a 02-$i-x.bed \
        -b 01-$i-genes.sorted.bed \
        -wo \
        > 03-$i-AntisenseOverlap.txt
done

# Get list of genes
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
cut -f10 03-$i-IntergenicDistance.tsv | sort -u > 04-$i-IntergenicGenes.txt
done
