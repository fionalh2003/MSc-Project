# Download database
wget https://ftp.ebi.ac.uk/pub/databases/Rfam/CURRENT/Rfam.cm.gz

# Unzip
gunzip Rfam.cm.gz

# Index the models 
cmpress Rfam.cm

# Run Rfam (00-Rfam.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
cmscan \
  --cpu 2 \
  --rfam \
  --cut_ga \
  --nohmmonly \
  --tblout 01-$i-rfam.tbl \
  Rfam.cm \
  04-$i-PfamFiltered.fasta \
  > 01-$i-rfam.out
done

# Extract Rfam hits (00-RfamHits.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
grep -v "^#" 01-$i-rfam.tbl | awk '{print $3}' | sort | uniq > 01-$i-rfam_hits.txt
wait
seqkit grep -v -f 01-$i-rfam_hits.txt 04-$i-PfamFiltered.fasta > 02-$i-lncRNA-Candidates.fasta
done

# Cluster file
grep -c "^>" 03-Joint-lncRNA.fasta 
cd-hit-est -i 03-Joint-lncRNA.fasta   -o 04-Clustered-lncRNA.fasta   -c 0.98   -aS 0.95   -aL 0.95   -G 0   -g 1   
