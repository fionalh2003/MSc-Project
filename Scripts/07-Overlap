# merge bed file with class code (00-Codes.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
awk '$3=="transcript"' 04-$i-GFFCompare.annotated.gtf | awk '
{
  match($0, /gene_id "([^"]+)"/, g);
  match($0, /class_code "([^"]+)"/, c);
  print g[1]"\t"c[1]
}' > 03-$i-Class.tsv
wait
awk '{count[$1" "$2]++; genes[$1]++} END {
for (i in count) {
split(i,a," ");
gene=a[1]; code=a[2];
print gene"\t"code
}
}' 03-$i-Class.tsv > 03-$i-gene-class.collapsed.tsv
wait
awk 'NR==FNR{a[$1]=$2; next} {print $0"\t"a[$2]}' \
03-$i-gene-class.collapsed.tsv \
07-$i-lncRNA-loci.bed \
> 08-$i-lncRNA-loci-codes.bed
done

# seperate the class codes (00-SeperateCodes.sh)
for i in 4401 A1 A4 A5 B3 C2 DAOM G1 SL1
do
awk '{print > "'09-$i'_"$6".bed"}' 08-$i-lncRNA-loci-codes.bed
done

# seperate by haplotype (00-Haplotype.sh) 
for i in A4 A5 G1 SL1
do
awk '$1 ~ /_Hap1$/' 07-$i-lncRNA-loci.bed > 07-${i}Hap1-lncRNA-loci.bed
wait
awk '$1 ~ /_Hap2$/' 07-$i-lncRNA-loci.bed > 07-${i}Hap2-lncRNA-loci.bed
done

# fix chromosomes (00-Chromosomes.sh)
for i in A4Hap1 A4Hap2 A5Hap1 A5Hap2 G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
awk 'BEGIN{OFS="\t"} {
  split($1,a,"_");
  gsub("chr","",a[1]);
  $1="chr_"a[1];
  print
}' 10-$i.bed > 10-$i-u.bed
wait
awk 'BEGIN{OFS="\t"} {
  split($1,a,"_");
  gsub("chr","",a[1]);
  $1="chr_"a[1];
  print
}' 01-$i-genes.bed > 010-$i-genes.bed
done

# sort the bed files (00-SortBED.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
sort -k1,1 -k2,2n 10-$i-u.clean.bed > 10-$i-u.sorted.bed
sort -k1,1 -k2,2n 01-$i-genes.bed > 01-$i-genes.sorted.bed
done

# Distance to gene for intergenic (00-IntergenicGenes.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
bedtools closest -a 10-$i-u.sorted.bed -b 01-$i-genes.sorted.bed -d > 06-$i-IntergenicDistance.tsv
done

# Merge distance and strain
for f in 06-*-IntergenicDistance.tsv; do strain=$(echo $f | sed 's/06-//' | sed 's/-IntergenicDistance.tvs//'); awk -v s="$strain" '{print $NF\t"s}' "$f"; done > 11-Intergenic.tsv

# Distance to gene for intergenic (00-IntergenicGenes.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
bedtools closest -a 02-A4Hap2-x.sorted.bed -b 01-$i-genes.sorted.bed -d > 06-$i-IntergenicDistance.tsv
done

# overlap for Sense (00-SenseOverlap.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
    bedtools intersect \
        -a 02-$i-o.bed6 \
        -b 01-$i-genes.sorted.bed \
        -s \
        -wo \
        > 03-$i-SenseOverlap.txt
done

# overlap for antisense (00-AntisenseOverlap.sh)
for i in 4401 A1 A4Hap1 A4Hap2 A5Hap1 A5Hap2 B3 C2 DAOM G1Hap1 G1Hap2 SL1Hap1 SL1Hap2
do
    bedtools intersect \
        -a 02-$i-x.bed6 \
        -b 01-$i-genes.sorted.bed \
        -S \
        -wo \
        > 03-$i-AntisenseOverlap.txt
done
